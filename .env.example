# Local SQLite database path used by the default backend.
DATABASE_URL=local.db

# Optional OAuth providers. Configure each provider with credentials from its developer console.
# Register callback URLs as https://<your-host>/auth/<provider>/callback.
# Leave values empty to keep that provider disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
